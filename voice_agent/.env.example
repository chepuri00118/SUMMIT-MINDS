# Telephony - twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Speech to text - deepgram.com
DEEPGRAM_API_KEY=

# Text to speech - elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Conversation brain - console.anthropic.com
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# Where Twilio reaches this server. In development use an ngrok https URL.
PUBLIC_BASE_URL=https://your-domain.example.com
PORT=8080

# Behaviour
ENDPOINTING_MS=300
MAX_SILENCE_SECONDS=12
MAX_CALL_SECONDS=300
CALL_WINDOW_START_HOUR=9
CALL_WINDOW_END_HOUR=17
DRY_RUN=false
