# Telephony - twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Speech to text - deepgram.com
DEEPGRAM_API_KEY=

# Text to speech - elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Conversation brain: "anthropic" (hosted, best quality, needs a key) or
# "ollama" (runs on this machine, no account, no key, nothing billed).
# Leave unset and it picks ollama when no Anthropic key is present.
BRAIN_PROVIDER=

# ...if anthropic - console.anthropic.com
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5

# ...if ollama - see scripts/setup_local.sh
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434

# Local speech, used by scripts/talk_local.py only. The phone path always uses
# Deepgram and ElevenLabs above.
WHISPER_MODEL=base.en
PIPER_VOICE=models/piper/en_US-lessac-medium.onnx

# Where Twilio reaches this server. In development use an ngrok https URL.
PUBLIC_BASE_URL=https://your-domain.example.com
PORT=8080

# Behaviour
ENDPOINTING_MS=300
MAX_SILENCE_SECONDS=12
MAX_CALL_SECONDS=300
CALL_WINDOW_START_HOUR=9
CALL_WINDOW_END_HOUR=17
DRY_RUN=false
